# ==============================================================================
# Environment Configuration Template
# Copy to .env and supply your credentials. NEVER commit .env to version control.
# ==============================================================================

# Supabase Configuration (Free Tier: https://supabase.com)
# Enables managed PostgreSQL with PostGIS extension, JWT Auth, and Realtime WS
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NASA FIRMS API (Free: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# Standard 32-character hex key required for automated VIIRS/MODIS hotspot feeds
FIRMS_MAP_KEY=your-firms-mapkey

# Target Geospatial Region (MVP Focus: Gujarat Industrial Belt)
# Format for bounding box: west_longitude,south_latitude,east_longitude,north_latitude (W,S,E,N)
TARGET_REGION=gujarat
TARGET_BBOX=68.0,20.0,78.0,26.0

# OpenStreetMap Overpass API
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ML Model Paths (Local or Mounted Storage)
MODEL_PATH=ml/models/model.pkl
ENCODER_PATH=ml/models/encoder.pkl

# Backend API Settings
SECRET_KEY=your-jwt-secret-at-least-32-chars-long
API_URL=http://localhost:8000
ENVIRONMENT=development

# Observability & Error Tracking (Free Tier: https://sentry.io)
SENTRY_DSN=
